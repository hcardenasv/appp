# ============================================================
# APPP — Variables de entorno
# Copiar a .env y completar con valores reales.
# NUNCA commitear .env al repositorio.
# ============================================================

# ---- PostgreSQL ----
PG_PASS=cambia_esto
DATABASE_URL=postgresql://appp:cambia_esto@localhost:5432/appp

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Telegram Bot ----
# Obtener de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# ---- Claude API (Anthropic) ----
ANTHROPIC_API_KEY=
# Modelo liviano para NLU de mensajes cortos
ANTHROPIC_MODEL_NLU=claude-haiku-4-5-20251001
# Modelo mayor para planificación y reportes
ANTHROPIC_MODEL_PLANNING=claude-sonnet-4-6
# Fusible: máximo de tokens por usuario por día (0 = sin límite)
ANTHROPIC_DAILY_TOKEN_LIMIT=100000

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=APPP <noreply@example.com>

# ---- Servidor ----
PORT=3000
NODE_ENV=development
TZ=America/Santiago
# URL pública del servidor (sin barra final); usada para construir el enlace /pwa del bot
APP_URL=http://localhost:3000

# ---- Web Push / VAPID (Hito 11 — PWA) ----
# Generar con: node -e "require('web-push').generateVAPIDKeys().then(k => console.log(JSON.stringify(k, null, 2))).catch(console.error)" 2>/dev/null || node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k,null,2))"
# O: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@appp.local

# ---- Vault-agent (Obsidian) ----
# Ruta absoluta al directorio del vault de Obsidian en el servidor
VAULT_PATH=/vault
# Intervalo de sincronización BD → vault en ms (por defecto 60000 = 1 minuto)
VAULT_SYNC_INTERVAL_MS=60000
